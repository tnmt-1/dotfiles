# ウィンドウの透過
background-opacity = 0.9

# 分割画面の非アクティブなウィンドウの透過度を設定
unfocused-split-opacity=0.4

# 前回のウィンドウの大きさを記憶
window-save-state = always

# 横方向（左右）の余白（ピクセル単位）
window-padding-x = 10

# 縦方向（上下）の余白（ピクセル単位）
window-padding-y = 10

# フォントサイズ
font-size = 15

# フォント
# 上から優先的に使用される（フォールバック）
font-family = "JetBrains Mono"
font-family = "源柔ゴシックL"
font-family = "FirgeNerd Console"

# 左右両方の Option を Alt として認識します
macos-option-as-alt = left

# ctrl + j を無視する
# macSKK使うときにひらがな切り替えできるようにする
#keybind = ctrl+j=ignore
