{
	"plugins": ["@cffnpwr/textlint-plugin-comments"],
	"rules": {
		"preset-jtf-style": {
			"2.1.6.カタカナの長音": false,
			"4.2.7.コロン(：)": false
		},
		"preset-ja-technical-writing": {
			"max-kanji-continuous-len": false,
			"arabic-kanji-numbers": false,
			"ja-no-mixed-period": false,
			"no-mix-dearu-desumasu": {
				"preferInHeader": "",
				"preferInBody": "",
				"preferInList": ""
			}
		}
	}
}
