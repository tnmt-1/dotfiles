[user]
	name = tnmt
	email = 14893567+tnmt-1@users.noreply.github.com

[pager]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[core]
	excludesfile = /Users/tnmt/.config/git/ignore

[ghq]
	root = ~/dev

[delta]
	side-by-side = true
	line-numbers = true
	navigate = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# 手元だけの設定（コミットしない）
[include]
	path = ~/.gitconfig.local
