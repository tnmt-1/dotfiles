  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "one-at-a-time",
  "extensions": [
    "-extensions/muxy-notify.ts",
    "-extensions/meta-cognitive-hooks.ts",
    "-extensions/test-regression-guard.ts",
    "+builtin:mcp",
    "+extensions/japanese-writing-hooks.ts"
  ],
  "permissions": {
    "*": "allow",
    "bash": {
      "rm *": "ask"
    }
  },
  "hideThinkingBlock": true,
  "markdown": {
    "mermaid": "final"
  },
  "defaultProjectTrust": "ask",
  "doubleEscapeAction": "tree",
  "tuiMode": "regular",
  "fullscreenScrollbar": "auto",
  "compaction": {
    "enabled": true
  },
  "outputPad": 0,
  "editorPaddingX": 0,
