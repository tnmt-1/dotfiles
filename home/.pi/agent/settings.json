{
  "lastChangelogVersion": "1.0.2",
  "theme": "dark/dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:pi-opencode-bridge",
    "npm:pi-observational-memory",
    "npm:@ryan_nookpi/pi-extension-headroom",
    {
      "source": "npm:pi-subagents",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "-skills/pi-subagents/SKILL.md"
      ]
    },
    "npm:pi-intercom",
    "npm:pi-add-dir",
    "npm:pi-web-access",
    "npm:pi-simplify",
    "npm:pi-permission-system",
    "npm:pi-hermes-memory",
    "npm:@bacnh85/pi-rtk@0.1.12",
    "npm:@ff-labs/pi-fff",
    "npm:pi-context-view",
    "npm:pi-ask-user",
    "npm:@devkade/pi-plan",
    "npm:@tmustier/pi-usage-extension",
    "npm:@tmustier/pi-raw-paste",
    "npm:pi-interactive-shell",
    "npm:@ogulcancelik/pi-minimal-footer",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-compact-ui",
    "npm:pi-review",
    "https://github.com/ayghri/i-have-adhd",
    "npm:@akepka/pi-cursor-cli-provider",
    "npm:pi-claude-bridge"
  ],
  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "one-at-a-time",
  "extensions": [],
  "permissions": {
    "*": "allow",
    "bash": {
      "rm *": "ask"
    }
  },
  "hideThinkingBlock": false,
  "markdown": {
    "mermaid": "final"
  },
  "defaultProjectTrust": "ask",
  "doubleEscapeAction": "tree",
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "compaction": {
    "enabled": true
  },
  "outputPad": 0,
  "editorPaddingX": 0,
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": ""
      },
      "planner": {
        "model": ""
      },
      "researcher": {
        "model": ""
      },
      "reviewer": {
        "model": ""
      },
      "scout": {
        "model": ""
      },
      "worker": {
        "model": ""
      }
    }
  },
  "skills": [
    "-skills/sdd/SKILL.md",
    "-skills/hunk-review/SKILL.md",
    "-skills/find-skills/SKILL.md",
    "-skills/code-review/SKILL.md"
  ],
  "enabledModels": [
    "github-copilot/gemini-3.8-flash",
    "github-copilot/gpt-6-luna",
    "cursor/grok-4.7-medium-fast",
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5"
  ],
  "modelThinkingLevels": {
    "github-copilot/gpt-6-luna": "high",
    "github-copilot/gemini-3.8-flash": "medium",
    "cursor/grok-4.7": "medium"
  },
  "terminal": {
    "clearOnShrink": false,
    "showImages": true
  },
  "defaultTools": [
    "+codemode"
  ],
  "observational-memory": {
    "model": {
      "provider": "github-copilot",
      "id": "gpt-6-luna"
    }
  }
}