    "github-copilot/gemini-3.8-flash": "high",
    "claude-code/claude-haiku-5-5": "low",
    "claude-code/claude-opus-5-5": "high"
  },
  "terminal": {
    "clearOnShrink": false,
    "showImages": true,
    "showTerminalProgress": false
  },
  "defaultTools": [
    "+codemode"
  ],
  "observational-memory": {
    "model": {
      "provider": "claude-code",
      "id": "claude-haiku-5-5",
      "thinking": "low"
