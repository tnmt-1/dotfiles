{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark/dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "packages": [
    "npm:@ryan_nookpi/pi-extension-headroom",
    "npm:@bacnh85/pi-rtk",
    "npm:@ff-labs/pi-fff",
    "git:github.com/DietrichGebert/ponytail",
    "https://github.com/ayghri/i-have-adhd",
    "git:github.com/elidickinson/pi-claude-bridge",
    "git:github.com/nicobailon/visual-explainer",
    {
      "source": "npm:pi-compact-ui",
      "extensions": [
        "-index.ts"
      ]
    },
    "git:github.com/michael-denyer/pstack-claude",
    "git:github.com/itisbryan/pi-add-dir",
    "git:github.com/nicobailon/pi-web-access",
    "git:github.com/MasuRii/pi-permission-system",
    "git:github.com/chandra447/pi-hermes-memory",
    "git:github.com/edlsh/pi-ask-user",
    "git:github.com/default-anton/pi-review",
    "git:github.com/nicobailon/pi-subagents",
    "git:github.com/carderne/pi-sandbox",
    "git:github.com/elpapi42/pi-observational-memory@3.1.4"
  ],
  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "one-at-a-time",
  "extensions": [
    "-extensions/muxy-notify.ts",
    "-extensions/meta-cognitive-hooks.ts"
  ],
  "permissions": {
    "*": "allow",
    "bash": {
      "rm *": "ask"
    }
  },
  "hideThinkingBlock": true,
  "markdown": {
    "mermaid": "final"
  },
  "defaultProjectTrust": "ask",
  "doubleEscapeAction": "tree",
  "tuiMode": "regular",
  "fullscreenScrollbar": "auto",
  "compaction": {
    "enabled": true
  },
  "outputPad": 0,
  "editorPaddingX": 0,
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "model": ""
      },
      "planner": {
        "model": ""
      },
      "researcher": {
        "model": ""
      },
      "reviewer": {
        "model": ""
      },
      "scout": {
        "model": ""
      },
      "worker": {
        "model": ""
      }
    }
  },
  "skills": [
    "-skills/sdd/SKILL.md"
  ],
  "enabledModels": [
    "github-copilot/gemini-3.8-flash",
    "github-copilot/gpt-6-luna",
    "claude-bridge/claude-opus-5-5",
    "claude-bridge/claude-sonnet-5-5",
    "github-copilot/gpt-6.1-sol",
    "claude-bridge/claude-fable-5-1"
  ],
  "modelThinkingLevels": {
    "github-copilot/gpt-6-luna": "max",
    "github-copilot/gemini-3.8-flash": "high",
    "cursor/grok-4.7": "high",
    "claude-bridge/claude-opus-5-5": "high"
  },
  "terminal": {
    "clearOnShrink": false,
    "showImages": true,
    "showTerminalProgress": false
  },
  "defaultTools": [
    "+codemode"
  ],
  "observational-memory": {
    "model": {
      "provider": "claude-bridge",
      "id": "claude-haiku-5-5",
      "thinking": "low"
    }
  },
  "warnings": {
    "anthropicExtraUsage": true
  },
  "fullscreenCopyOnSelect": true
}