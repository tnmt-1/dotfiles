{
    "Ctrl-r": "command:tree",

    // 行頭・行末 (Emacs 風)
    "Ctrl-a": "StartOfLine",
    "Ctrl-e": "EndOfLine",

    // Ctrlの組み合わせだったけど、Altに移動した
    "Alt-a": "SelectAll",
    "Alt-e": "CommandMode",

    // 単語移動 (Emacs 風、vi の w/b に相当)
    "Alt-f": "WordRight",
    "Alt-b": "WordLeft",

    // 保存（Ctrl-s はフロー制御に奪われるため Alt に避難）
    "Alt-s": "Save"
}
