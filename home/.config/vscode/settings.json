{
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
        "editor.tabSize": 4,
        "editor.insertSpaces": true
    },
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": false,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },
    "ruff.configuration": {
        "target-version": "py311",
        "src": [
            "src"
        ],
        "line-length": 108,
        "lint": {
            "select": [
                "C9",
                "E",
                "F",
                "W",
                "I",
                "AIR"
            ],
            "ignore": [
                "E501"
            ],
            "mccabe": {
                "max-complexity": 15
            }
        }
    },
    "chat.agent.maxRequests": 100,
    "chat.editor.fontSize": 14,
    "chat.fontSize": 15,
    "chat.hookFilesLocations": {
        ".claude/hooks": true
    },
    "chat.mcp.gallery.enabled": true,
    "chat.useAgentSkills": true,
    "chat.useClaudeHooks": true,
    "cSpell.userWords": [
        "Authlete",
        "excinfo",
        "invokable",
        "Nuxt",
        "PKCE",
        "REISSUABLE",
        "uniikey",
        "Vuetify"
    ],
    "editor.fontFamily": "JetBrains Mono NL, \"源柔ゴシックL\", Gen Interface JP, Hack Nerd Font Mono, monospace",
    "editor.fontSize": 16,
    "editor.formatOnSave": true,
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.renderWhitespace": "all",
    "editor.stickyScroll.enabled": false,
    "files.associations": {
        "*.md": "markdown"
    },
    "files.autoSave": "afterDelay",
    "github.copilot.chat.agent.autoFix": true,
    "github.copilot.chat.anthropic.tools.websearch.enabled": true,
    "github.copilot.chat.codesearch.enabled": true,
    "github.copilot.chat.newWorkspace.useContext7": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "indentRainbow.colorOnWhiteSpaceOnly": true,
    "markdown.extension.list.indentationSize": "inherit",
    "markdown.preview.breaks": true,
    "markdown.preview.fontSize": 15,
    "scm.repositories.selectionMode": "single",
    "tableformatter.common.centerAlignedHeader": false,
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.gpuAcceleration": "off",
    "terminal.integrated.lineHeight": 1.3,
    "terminal.integrated.suggest.enabled": false,
    "workbench.activityBar.location": "top",
    "workbench.iconTheme": "catppuccin-mocha",
    "workbench.secondarySideBar.defaultVisibility": "visible",
    "indentRainbow.ignoreErrorLanguages": [
        "markdown",
        "python"
    ],
    // 一時的な処置: Poetryを使用しているプロジェクトで、Python環境が正しく認識されない問題を回避するための設定
    "python-envs.defaultEnvManager": "ms-python.python:poetry",
    "python-envs.defaultPackageManager": "ms-python.python:poetry",
    "files.defaultLanguage": "markdown",
    "chat.tips.enabled": false,
    "chat.viewSessions.orientation": "stacked",
    "security.workspace.trust.untrustedFiles": "open",
    "terminal.integrated.fontSize": 15,
    "python.terminal.activateEnvironment": false,
    "terminal.integrated.shellIntegration.enabled": false,
    "[yaml]": {
        "diffEditor.ignoreTrimWhitespace": true
    },
    "python.analysis.referencesCodeLens": true,
    "accessibility.signals.clear": {
        "sound": "off",
        "announcement": "auto"
    },
    "accessibility.signals.codeActionApplied": {
        "sound": "off"
    },
    "accessibility.signals.codeActionTriggered": {
