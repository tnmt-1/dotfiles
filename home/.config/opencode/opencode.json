{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "headroom": {
        "type": "local",
        "command": [
          "/Users/tnmt/.local/share/mise/installs/pipx-headroom-ai/latest/bin/headroom",
          "mcp",
          "serve"
        ],
        "disabled": false
      }
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp",
    "opencode-mem",
    "oh-my-openagent@latest"
  ],
  "lsp": false,
  "permissions": [
    {
      "action": "read",
      "resource": "~/Documents/chiraura/**",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/dev/**",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.config/**",
      "effect": "allow"
    }
  ]
}
