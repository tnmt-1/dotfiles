{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "headroom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Headroom Proxy",
      "options": {
        "baseURL": "http://127.0.0.1:8787/v1"
      }
    }
  },
  "mcp": {
    "headroom": {
      "type": "local",
      "command": [
        "/Users/tnmt/.local/bin/headroom",
        "mcp",
        "serve"
      ],
      "enabled": true
    }
  }
}
